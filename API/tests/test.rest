@baseUrl = http://localhost:3000/api
@authToken = {{login.response.body.user.token}}

### Register user 
# @name register

POST  {{baseUrl}}/users/register
Content-Type: application/json

{
    "username": "teszt1",
    "email": "teszt@gmail.com",
    "password": "Teszt123",
    "gender": "férfi",
    "defAddress": "1000, Teszt, teszt1",
    "favCategories": "",
    "birthDate":"2000-01-01",
    "image":"",
    "role": "user",
    "status": "active"
}

### login user
# @name login

POST  {{baseUrl}}/users/login
Content-Type: application/json

{
    "email": "teszt@gmail.com",
    "password": "Teszt123"
}

### login company
# @name CompanyLogin

POST  {{baseUrl}}/company/login
Content-Type: application/json

{
