@baseUrl = http://localhost:3000/api
@authToken = {{login.response.body.user.token}}

### Register user 
# @name register

POST  {{baseUrl}}/users/register
Content-Type: application/json

{
    "username": "pisti",
    "email": "pisti@gmail.com",
    "password": "Pisti123",
    "gender": "férfi",
    "defAddress": "1000, Teszt, teszt1",
    "favCategories": "",
    "birthDate":"2000-01-01",
    "image":"",
    "role": "user",
    "status": "active"
}

### login user
# @name login

POST  {{baseUrl}}/users/login
Content-Type: application/json

{
    "email": "teszt@gmail.com",
    "password": "Teszt123"
}

### login company
# @name CompanyLogin

POST  {{baseUrl}}/company/login
Content-Type: application/json

{
    "email": "asd@gmail.com",
    "password": "asd123"
}

### update password
# @name password

PATCH {{baseUrl}}/users/password/15abfcd3-ead0-4acc-bee4-e31ef9b89db9
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
    "password": "Teszt321",
    "confirm": "Teszt321"
}

