### EVENTS ###

### New Event
# @name newEvent
POST {{baseUrl}}/event/newevent
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
    "eventName": "Retro Feeling koncert",
    "eventStart": "10:00",
    "eventEnd": "13:00",
    "eventAddress": "6500, Baja, Bácska tér, 5",
    "eventDate": "2025-04-05",
    "userId": "97c7e329-8f30-4f82-92c7-2aa6a8be95c9",
    "catId": "2",
    "description": "nagyon jo esemény gyere el"

}

### Get all Events
# @name getAll
GET {{baseUrl}}/event/get
Authorization: Bearer {{authToken}}

### Get one Event by id
# @name getOneById
GET {{baseUrl}}/event/get/a0c50a4b-8a57-4eb0-bf8d-e233b6cf0ae7
Authorization: Bearer {{authToken}}

### Delete Event
# @name deleteEvent
DELETE {{baseUrl}}/event/delete/89c01c2a-9448-4fde-8339-93f183b69f5e 
Content-Type: application/json 
Authorization: Bearer {{authToken}}

### Update Event
# @name updateEvent

PATCH  {{baseUrl}}/event/update/d80c709d-2204-4e33-a4aa-9ba570c2cc89
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
    "description": "Leírás módosítása"
}


